{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "packages/design-system/src/components/Accordion/**",
              "packages/design-system/src/components/AlertDialog/**",
              "packages/design-system/src/components/Avatar/**",
              "packages/design-system/src/components/Banner/**",
              "packages/design-system/src/components/BreadCrumbs/**",
              "packages/design-system/src/components/ButtonGroup/**",
              "packages/design-system/src/components/Checkbox/**",
              "packages/design-system/src/components/Drawer/**",
              "packages/design-system/src/components/EmptyScreenPlaceholder/**",
              "packages/design-system/src/components/FieldGroup/**",
              "packages/design-system/src/components/InfoStrip/**",
              "packages/design-system/src/components/InputGroup/**",
              "packages/design-system/src/components/InputHintText/**",
              "packages/design-system/src/components/Loaders/**",
              "packages/design-system/src/components/Modal/**",
              "packages/design-system/src/components/PopConfirm/**",
              "packages/design-system/src/components/Popover/**",
              "packages/design-system/src/components/RadioGroup/**",
              "packages/design-system/src/components/SectionHeader/**",
              "packages/design-system/src/components/Separator/**",
              "packages/design-system/src/components/Sidebar/**",
              "packages/design-system/src/components/SingleSelect/**",
              "packages/design-system/src/components/Skeleton/**",
              "packages/design-system/src/components/Stepper/**",
              "packages/design-system/src/components/Switch/**",
              "packages/design-system/src/components/Tabs/**",
              "packages/design-system/src/components/TextArea/**",
              "packages/design-system/src/components/TextLink/**",
              "packages/design-system/src/components/Toast/**",
              "packages/design-system/src/components/Toggle/**",
              "packages/design-system/src/components/Tooltip/**",
              "ui_kits/web_app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Satoshi))/i]",
        "message": "Font not provided by the design system. Available: Satoshi."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
